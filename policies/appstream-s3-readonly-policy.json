{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadOnlyAppStreamBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::my-appstream-storage",
        "arn:aws:s3:::my-appstream-storage/*"
      ]
    },
    {
      "Sid": "ExplicitlyDenyWriteAndDelete",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "s3:PutBucketPolicy"
      ],
      "Resource": [
        "arn:aws:s3:::my-appstream-storage",
        "arn:aws:s3:::my-appstream-storage/*"
      ]
    }
  ]
}
